# Base de datos. Por defecto usa SQLite (cero configuración).
# Para usar MySQL, pon DB_DRIVER=mysql y completa el resto.
DB_DRIVER=sqlite
# DB_PATH=./data/scrap.sqlite

# --- Solo si DB_DRIVER=mysql ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=scrapenvases
# DB_USER=root
# DB_PASS=

# --- Herramientas del core ---
# Sitio de producto de cada herramienta (lo que se enlaza por defecto).
# URL_SCRAPP=https://scrapp.es/
# URL_INPROGEST=https://inprogest.com/
# URL_PROBATUS=https://probatus.es/

# Entorno de DEMOSTRACIÓN con datos ficticios y usuario de invitado.
# Si lo defines, el pie de cada demo ofrece "Abrir la aplicación real".
# NO pongas aquí la instancia de un cliente (p. ej. recyclia.scrapp.es):
# es su panel de producción, con sus datos y su login.
# DEMO_SCRAPP=https://demo.scrapp.es/
# DEMO_INPROGEST=https://demo.inprogest.com/
# DEMO_PROBATUS=https://demo.probatus.es/

# --- Oficina Técnica de SCRAPs (OTS) ---
# Buzón al que se avisa de cada consulta nueva del formulario de /contacto.
# Si se deja vacío, las consultas se guardan solo en el panel (no se pierde
# ninguna) y la página muestra los datos de contacto como "por confirmar".
# OTS_EMAIL=ots@scrapenvases.com
# OTS_TEL=+34 900 000 000
