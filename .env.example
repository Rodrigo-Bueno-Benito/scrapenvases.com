# Base de datos. Por defecto SQLite (cero configuración).
DB_DRIVER=sqlite
# DB_PATH=./data/scrap.sqlite

# --- Solo si DB_DRIVER=mysql ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=scrapenvases
# DB_USER=root
# DB_PASS=

# --- Oficina Técnica de SCRAPs (OTS) ---
# Bandeja que recibe cada consulta del formulario de /contacto.
# OTS_EMAIL=ots@scrapenvases.com
# Email que se muestra en "Contacto directo" si es distinto del anterior.
# OTS_EMAIL_PUBLICO=ots@scrapenvases.com
# Teléfono de la OTS. Sin definir, no se muestra.
# OTS_TEL=
# Remitente de los avisos por correo.
# MAIL_FROM=no-reply@scrapenvases.com

# --- Primer usuario del panel /admin (solo en una instalación nueva) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Web de cada herramienta (por defecto, su dominio) ---
# URL_SCRAPP=https://scrapp.es/
# URL_INPROGEST=https://inprogest.com/
# URL_PROBATUS=https://probatus.es/
